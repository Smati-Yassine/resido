# Copy to .env.local and fill in real values. Never commit .env.local.
# MONGODB_URI is a secret even for a test/dev database — never hard-code it,
# never prefix any of these with NEXT_PUBLIC_.

MONGODB_URI=
MONGODB_DB=

AUTH_SECRET=


OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_REGION=

# Auth.js only trusts the request Host header automatically in `next dev`.
# Set to true for `next start` locally or behind a proxy you control
# (Vercel sets this for you).
AUTH_TRUST_HOST=true
